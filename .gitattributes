# 统一换行：Windows 安装默认 core.autocrlf=true，会让仓库内容随平台漂移。
# 源码与文本一律 LF 入库；Windows 专用脚本保留 CRLF。
* text=auto

*.go      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.work    text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf

*.exe     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
